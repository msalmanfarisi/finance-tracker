generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  appName   String   @default("Finance Tracker")
  currency  String   @default("IDR")
  locale    String   @default("id")
  theme     String   @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  roles         Role[]
  budgets       Budget[]
  incomes       Income[]
  expenses      Expense[]
  debts         Debt[]
  receivables   Receivable[]
  incomePlans   IncomePlan[]
  categories    Category[]
  notifications Notification[]
  settings      Setting[]
  backups       Backup[]

  @@map("tenants")
}

model User {
  id            String    @id @default(cuid())
  email         String
  name          String
  password      String
  avatar        String?
  phone         String?
  address       String?
  locale        String    @default("id")
  theme         String    @default("system")
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  budgets       Budget[]
  incomes       Income[]
  expenses      Expense[]
  debts         Debt[]
  receivables   Receivable[]
  incomePlans   IncomePlan[]
  notifications Notification[]
  sessions      Session[]
  auditLogs     AuditLog[]

  @@unique([email, tenantId])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@map("sessions")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  permissions Json
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  users User[]

  @@unique([name, tenantId])
  @@map("roles")
}

model Category {
  id       String @id @default(cuid())
  name     String
  type     String // income, expense, budget
  icon     String @default("circle")
  color    String @default("#6366f1")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  budgets   Budget[]
  incomes   Income[]
  expenses  Expense[]

  @@unique([name, type, tenantId])
  @@map("categories")
}

model Budget {
  id        String   @id @default(cuid())
  name      String
  amount    Decimal  @db.Decimal(15, 2)
  spent     Decimal  @default(0) @db.Decimal(15, 2)
  period    String   // monthly, quarterly, yearly
  startDate DateTime
  endDate   DateTime
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("budgets")
}

model Income {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(15, 2)
  date        DateTime
  source      String?
  notes       String?  @db.Text
  isRecurring Boolean  @default(false)
  recurType   String?  // weekly, monthly, yearly
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("incomes")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Decimal  @db.Decimal(15, 2)
  date        DateTime
  vendor      String?
  notes       String?  @db.Text
  receipt     String?
  isRecurring Boolean  @default(false)
  recurType   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model Debt {
  id          String    @id @default(cuid())
  creditor    String
  amount      Decimal   @db.Decimal(15, 2)
  remaining   Decimal   @db.Decimal(15, 2)
  interest    Decimal   @default(0) @db.Decimal(5, 2)
  dueDate     DateTime?
  description String?   @db.Text
  status      String    @default("active") // active, paid, overdue
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payments DebtPayment[]

  @@map("debts")
}

model DebtPayment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(15, 2)
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  debtId String
  debt   Debt   @relation(fields: [debtId], references: [id], onDelete: Cascade)

  @@map("debt_payments")
}

model Receivable {
  id          String    @id @default(cuid())
  debtor      String
  amount      Decimal   @db.Decimal(15, 2)
  remaining   Decimal   @db.Decimal(15, 2)
  dueDate     DateTime?
  description String?   @db.Text
  status      String    @default("active") // active, received, overdue
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payments ReceivablePayment[]

  @@map("receivables")
}

model ReceivablePayment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(15, 2)
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())

  receivableId String
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)

  @@map("receivable_payments")
}

model IncomePlan {
  id          String   @id @default(cuid())
  description String
  targetAmount Decimal @db.Decimal(15, 2)
  currentAmount Decimal @default(0) @db.Decimal(15, 2)
  source      String?
  targetDate  DateTime
  status      String   @default("planned") // planned, in_progress, achieved
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("income_plans")
}

model Notification {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  type      String   @default("info") // info, warning, success, error
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Setting {
  id        String   @id @default(cuid())
  key       String
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([key, tenantId])
  @@map("settings")
}

model Backup {
  id        String   @id @default(cuid())
  filename  String
  size      Int
  type      String   // sql, zip, gz
  path      String
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("backups")
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
